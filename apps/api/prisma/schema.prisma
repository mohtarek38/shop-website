// Logical design: docs/DATABASE.md. Models are added phase by phase.
// Conventions: UUIDv7 ids, snake_case tables/columns, timestamptz, money as integer piasters.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── identity: Better Auth tables (ADR-0009) ───────────────────────────────
// Field names must match Better Auth's model; column names are mapped to snake_case.

enum UserType {
  customer
  staff

  @@map("user_type")
}

enum Locale {
  ar
  en

  @@map("locale")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  /// Real email, or synthetic `<digits>@phone.invalid` for phone-only customers.
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  /// Username plugin: E.164 phone for customers who log in by phone.
  username        String?   @unique
  displayUsername String?   @map("display_username")
  type            UserType  @default(customer)
  locale          Locale    @default(ar)
  /// Set when staff deactivate an account; blocks new sessions and all requests.
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]
  roles    UserRole[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

// ─── identity: our RBAC (PLAN §6.2) ────────────────────────────────────────

/// Seeded from `@shop/contracts` PERMISSIONS; read-only at runtime.
model Permission {
  key         String @id
  module      String
  description Json?

  roles RolePermission[]

  @@map("permission")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  /// LocalizedText {ar, en}
  name      Json
  /// System roles can't be deleted; `owner` always has every permission.
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ─── catalog (DATABASE.md §6) ──────────────────────────────────────────────

enum AttributeType {
  text
  number
  boolean
  enum

  @@map("attribute_type")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  /// LocalizedText {ar, en}
  name      Json
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brand")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  slug           String   @unique
  name           Json
  description    Json?
  seoTitle       Json?    @map("seo_title")
  seoDescription Json?    @map("seo_description")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]

  @@index([parentId])
  @@map("category")
}

/// Spec template for a category; child categories inherit their parent's attributes.
model CategoryAttribute {
  id              String        @id @default(uuid(7)) @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  key             String
  label           Json
  type            AttributeType
  unit            Json?
  /// For enum: [{ value, label: {ar, en} }]
  options         Json          @default("[]")
  isRequired      Boolean       @default(false) @map("is_required")
  isFilterable    Boolean       @default(false) @map("is_filterable")
  isComparable    Boolean       @default(true) @map("is_comparable")
  isVariantOption Boolean       @default(false) @map("is_variant_option")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@map("category_attribute")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  brandId          String        @map("brand_id") @db.Uuid
  slug             String        @unique
  name             Json
  shortDescription Json?         @map("short_description")
  description      Json?
  /// Product-level spec values, validated against the category's attributes.
  specs            Json          @default("{}")
  isLargeItem      Boolean       @default(false) @map("is_large_item")
  warrantyMonths   Int?          @map("warranty_months")
  status           ProductStatus @default(draft)
  seoTitle         Json?         @map("seo_title")
  seoDescription   Json?         @map("seo_description")
  /// Normalized ar+en name, brand, model numbers and SKUs (ADR-0017). Maintained by the app.
  searchText       String        @default("") @map("search_text")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductMedia[]

  @@index([status, categoryId])
  @@index([brandId])
  @@index([specs(ops: JsonbPathOps)], type: Gin)
  @@map("product")
}

/// Every product has at least one variant (its SKU and price live here).
model ProductVariant {
  id           String    @id @default(uuid(7)) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  sku          String    @unique
  modelNumber  String?   @map("model_number")
  /// Values for variant-option attributes, e.g. { color: "silver" }
  options      Json      @default("{}")
  /// Piasters, VAT-inclusive (ADR-0011)
  price        Int
  salePrice    Int?      @map("sale_price")
  saleStartsAt DateTime? @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt   DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  weightGrams  Int?      @map("weight_grams")
  lengthMm     Int?      @map("length_mm")
  widthMm      Int?      @map("width_mm")
  heightMm     Int?      @map("height_mm")
  barcode      String?
  isActive     Boolean   @default(true) @map("is_active")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movements   StockMovement[]

  @@index([productId])
  @@index([modelNumber])
  @@map("product_variant")
}

// ─── media (DATABASE.md §7, ADR-0018) ──────────────────────────────────────

enum MediaBucket {
  /// Product images and banners, served publicly (R2 + CDN in production)
  public
  /// Transfer receipts; served only through short-lived signed URLs
  private

  @@map("media_bucket")
}

model Media {
  id           String      @id @default(uuid(7)) @db.Uuid
  bucket       MediaBucket
  /// Key of the original file in storage
  storageKey   String      @unique @map("storage_key")
  /// Resized WebP keys: { thumb, md, lg }
  variants     Json        @default("{}")
  mimeType     String      @map("mime_type")
  width        Int?
  height       Int?
  sizeBytes    Int         @map("size_bytes")
  originalName String?     @map("original_name")
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  productImages ProductMedia[]

  @@map("media")
}

/// A product's images, in display order (the first is the main image).
model ProductMedia {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  /// LocalizedText; falls back to the product name
  alt       Json?
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}

// ─── inventory (DATABASE.md §8, ADR-0013) ──────────────────────────────────

model StockLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      Json
  address   String?
  /// Exactly one default location (partial unique index in the migration)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  levels    StockLevel[]
  movements StockMovement[]

  @@map("stock_location")
}

/// Stock of one variant at one location. Available = on_hand - reserved.
model StockLevel {
  variantId         String   @map("variant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int?     @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([variantId, locationId])
  @@index([locationId])
  @@map("stock_level")
}

enum StockMovementType {
  receive
  adjust
  write_off
  transfer_out
  transfer_in
  reserve
  release
  fulfil
  return

  @@map("stock_movement_type")
}

/// Append-only ledger: every change to stock_level writes a row here in the same transaction.
model StockMovement {
  id            String            @id @default(uuid(7)) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  type          StockMovementType
  onHandDelta   Int               @map("on_hand_delta")
  reservedDelta Int               @default(0) @map("reserved_delta")
  /// On hand after this movement, for easy history reading
  onHandAfter   Int               @map("on_hand_after")
  reason        String?
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  actorId       String?           @map("actor_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([locationId, createdAt])
  @@map("stock_movement")
}
