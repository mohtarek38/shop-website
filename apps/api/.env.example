# Copy to .env for local development. Values here are for local dev only.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://shop:shop@localhost:5433/shop

# Auth (Better Auth). Generate a real secret for any shared environment: openssl rand -base64 32
AUTH_SECRET=local-dev-only-secret-not-for-production-use
AUTH_BASE_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# First owner account, created by `pnpm db:seed` (local dev only)
OWNER_NAME=Dev Owner
OWNER_EMAIL=owner@shop.local
OWNER_PASSWORD=dev-owner-password-123

# Disposable database for e2e tests (recreated on every run; name must end in _test)
DATABASE_URL_TEST=postgresql://shop:shop@localhost:5433/shop_test
