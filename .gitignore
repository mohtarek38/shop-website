# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test artifacts
playwright-report/
test-results/

# Local data
*.dump
*.sql.gz
backups/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
